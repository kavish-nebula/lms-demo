# Copy to .env.local (gitignored) and fill in what you need.
# Never put real keys in this file: it is committed.

# The language model behind the course planner, Pip and the profiling helpers.
# Any OpenAI-compatible API, or Claude (LLM_PROVIDER=anthropic). Without a key,
# everything falls back to rules. Examples:
#   Google Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                  LLM_MODEL=gemini-3.5-flash  LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
#   OpenAI:        (no base URL needed)  LLM_MODEL=gpt-4o-mini
#   Claude:        LLM_PROVIDER=anthropic  LLM_MODEL=claude-haiku-5-5
LLM_API_KEY=
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_FALLBACK_MODEL=
# LLM_REASONING=disabled

# Older setting, used only when LLM_API_KEY is empty:
# GLM (Z.ai) plans each learner's course. Without a key, learners get the
# rule-based standard setup and no AI calls are made.
# Create a key at https://z.ai (international) or https://open.bigmodel.cn (China).
GLM_API_KEY=
# Optional: China platform keys use https://open.bigmodel.cn/api/paas/v4
# GLM_BASE_URL=https://api.z.ai/api/paas/v4
# Optional: the model. The default glm-4.7-flash is free; glm-5.3 writes
# better plans but needs balance on the Z.ai account.
# GLM_MODEL=glm-4.7-flash
# Optional: tried while the main model is busy (default glm-4.5-flash, also
# free); "none" turns it off.
# GLM_FALLBACK_MODEL=glm-4.5-flash
# Optional: "enabled" turns on the model's reasoning (several times slower).
# GLM_THINKING=disabled

# Learner database. Leave unset to use the built-in Postgres (PGlite),
# stored in apps/web/.data/pglite. Set it to use a real Postgres server,
# e.g. Cloud SQL in production:
# DATABASE_URL=postgres://user:password@host:5432/lms

# Platform motivation features. Disabled unless explicitly enabled.
PLATFORM_ENGAGEMENT_ENABLED=false

# Adaptive lessons: narration for rewritten lessons. With an audio key, Gemini text-to-speech speaks it
# (a few clips at a time); Kokoro is the fallback when the API is busy or out of quota.
# AUDIO_PROVIDER=gemini
# AUDIO_API_KEY=
# AUDIO_MODEL=gemini-3.8-flash-lite-tts
# AUDIO_VOICE=Charon
# AUDIO_STYLE=A warm, clear course narrator explaining a lesson to an adult learner, at a steady, unhurried pace.
# AUDIO=off
#
# Kokoro (kokoro-js), on this machine:
# The model (~330 MB at fp32) downloads on first use. KOKORO=off plays rewritten lessons with captions only.
# KOKORO_DEVICE: cpu (default), dml (DirectML GPU on Windows), cuda (NVIDIA on Linux); a GPU that fails falls back to cpu.
# KOKORO_DTYPE: fp32 (default; fastest on CPU), fp16, q8
# KOKORO=off
# KOKORO_VOICE=am_michael
# KOKORO_DEVICE=cpu
# KOKORO_DTYPE=fp32

# Adaptive platform providers and local artifact configuration
# Copy to .env.local (gitignored) and fill in what you need.
# Never put real keys in this file: it is committed.

# Adaptive prerequisites, activity evaluation and course planning use Vertex AI.
# Authenticate locally with Application Default Credentials; on GCP use the
# attached workload service account. Credentials stay outside this repository.
# GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# Performance/cost defaults; no Pro model is used for routine generation.
GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image,gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts
# Optional durable local volume for session artifacts and generated media:
# ADAPTIVE_ONBOARDING_DIR=/path/to/private/persistent-volume

# GLM (Z.ai) plans each learner's course. Without a key, learners get the
# rule-based standard setup and no AI calls are made.
# Create a key at https://z.ai (international) or https://open.bigmodel.cn (China).
GLM_API_KEY=
# Optional: China platform keys use https://open.bigmodel.cn/api/paas/v4
# GLM_BASE_URL=https://api.z.ai/api/paas/v4
# Optional: the model. The default glm-4.7-flash is free; glm-5.3 writes
# better plans but needs balance on the Z.ai account.
# GLM_MODEL=glm-4.7-flash
# Optional: tried while the main model is busy (default glm-4.5-flash, also
# free); "none" turns it off.
# GLM_FALLBACK_MODEL=glm-4.5-flash
# Optional: "enabled" turns on the model's reasoning (several times slower).
# GLM_THINKING=disabled

# Learner database. Leave unset to use the built-in Postgres (PGlite),
# stored in apps/web/.data/pglite. Set it to use a real Postgres server,
# e.g. Cloud SQL in production:
# DATABASE_URL=postgres://user:password@host:5432/lms

# Platform motivation features. Disabled unless explicitly enabled.
PLATFORM_ENGAGEMENT_ENABLED=false

# Live generation (Discovery conversation) with Google Gemini. Get a key at https://aistudio.google.com/apikey
# Alternative to Vertex AI: leave GOOGLE_CLOUD_PROJECT unset and use this key.
# The new adaptive flow offers retry when generation is unavailable; it never
# silently switches to the historical static quiz or rule-based decisions.
GEMINI_API_KEY=
# Model chains: first model first; busy or failing models hand over to the next. Comma-separated to override.
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# GEMINI_FAST_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# GEMINI_STRONG_MODEL=gemini-3.1-pro-preview,gemini-3.6-flash
# GEMINI_CODE_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1,gemini-3.1-flash-image,gemini-3.1-flash-lite-image

# Existing local companion voice (profiling uses the Vertex voice above).
VOICE_PROVIDER=kokoro
# KOKORO_DTYPE=q8
