  "items": [
    {
      "id": "p1",
      "lesson": "1.1",
      "module": "m1",
      "stem": "What starts a workflow running?",
      "options": [
        {
          "id": "a",
          "text": "A trigger — an event such as a new row or a webhook"
        },
        {
          "id": "b",
          "text": "Opening the editor"
        },
        {
          "id": "c",
          "text": "The last node in the chain"
        }
      ]
    },
    {
      "id": "p2",
      "lesson": "1.1",
      "module": "m1",
      "stem": "What is an “execution”?",
      "options": [
        {
          "id": "a",
          "text": "The workflow’s settings page"
        },
        {
          "id": "b",
          "text": "A node that sends messages"
        },
        {
          "id": "c",
          "text": "One run of the workflow, from the trigger to the last node"
        }
      ]
    },
    {
      "id": "p3",
      "lesson": "1.2",
      "module": "m1",
      "stem": "A trigger picks up 5 new rows at once. How many items flow into the next node?",
      "options": [
        {
          "id": "a",
          "text": "None until someone approves them"
        },
        {
          "id": "b",
          "text": "5 — one item per row"
        },
        {
          "id": "c",
          "text": "1 — the rows are merged"
        }
      ]
    },
    {
      "id": "p4",
      "lesson": "1.2",
      "module": "m1",
      "stem": "What does a Filter node do with an item that fails its condition?",
      "options": [
        {
          "id": "a",
          "text": "Stops it — it goes no further"
        },
        {
          "id": "b",
          "text": "Sends it twice"
        },
        {
          "id": "c",
          "text": "Deletes the source row"
        }
      ]
    },
    {
      "id": "p5",
      "lesson": "1.3",
      "module": "m1",
      "stem": "In a lead-alert pipeline, where should the “block empty rows” filter sit?",
      "options": [
        {
          "id": "a",
          "text": "After the alert is sent"
        },
        {
          "id": "b",
          "text": "It makes no difference"
        },
        {
          "id": "c",
          "text": "Before the alert is sent"
        }
      ]
    },
    {
      "id": "p6",
      "lesson": "1.3",
      "module": "m1",
      "stem": "A run shows green, but nobody got the alert. What do you check first?",
      "options": [
        {
          "id": "a",
          "text": "Whether the sheet is sorted"
        },
        {
          "id": "b",
          "text": "The last node’s response in the run data"
        },
        {
          "id": "c",
          "text": "The workflow’s name"
        }
      ]
    },
    {
      "id": "p7",
      "lesson": "2.1",
      "module": "m2",
      "stem": "What does an expression that trims and lower-cases an email field do?",
      "options": [
        {
          "id": "a",
          "text": "Cleans that field for each item as it passes through"
        },
        {
          "id": "b",
          "text": "Runs once and rewrites the sheet"
        },
        {
          "id": "c",
          "text": "Sends an email"
        }
      ]
    },
    {
      "id": "p8",
      "lesson": "2.1",
      "module": "m2",
      "stem": "An expression returns “undefined”. Most likely cause?",
      "options": [
        {
          "id": "a",
          "text": "The workflow is too long"
        },
        {
          "id": "b",
          "text": "The trigger is paused"
        },
        {
          "id": "c",
          "text": "The field name is misspelled or missing"
        }
      ]
    },
    {
      "id": "p9",
      "lesson": "2.2",
      "module": "m2",
      "stem": "What is the Set (Edit Fields) node for?",
      "options": [
        {
          "id": "a",
          "text": "Starting the workflow"
        },
        {
          "id": "b",
          "text": "Renaming, adding and reshaping fields"
        },
        {
          "id": "c",
          "text": "Stopping items"
        }
      ]
    },
    {
      "id": "p10",
      "lesson": "2.2",
      "module": "m2",
      "stem": "Some rows have no plan value and the CRM requires one. Cleanest approach?",
      "options": [
        {
          "id": "a",
          "text": "Fill a default in the Set node"
        },
        {
          "id": "b",
          "text": "Delete those rows by hand"
        },
        {
          "id": "c",
          "text": "Let the CRM reject them"
        }
      ]
    },
    {
      "id": "p11",
      "lesson": "2.3",
      "module": "m2",
      "stem": "Why normalise emails before removing duplicates?",
      "options": [
        {
          "id": "a",
          "text": "It makes the workflow faster"
        },
        {
          "id": "b",
          "text": "Duplicates can’t be removed otherwise"
        },
        {
          "id": "c",
          "text": "So two spellings of the same address are seen as the same"
        }
      ]
    },
    {
      "id": "p12",
      "lesson": "2.3",
      "module": "m2",
      "stem": "500 rows go in and 376 reach the CRM. What should you be able to say about the other 124?",
      "options": [
        {
          "id": "a",
          "text": "That the CRM lost them"
        },
        {
          "id": "b",
          "text": "Exactly why each one was stopped"
        },
        {
          "id": "c",
          "text": "Nothing — they were junk"
        }
      ]
    }
  ]
}
